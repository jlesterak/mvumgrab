#!/usr/bin/env bash
# Start the mvumgrab web UI (http://127.0.0.1:8765). Needs python3 + docker.
cd "$(dirname "$(readlink -f "$0")")" || exit 1
command -v docker >/dev/null || { echo "docker not found"; exit 1; }
docker image inspect ghcr.io/osgeo/gdal:ubuntu-full-latest >/dev/null 2>&1 || docker pull ghcr.io/osgeo/gdal:ubuntu-full-latest
exec python3 -m mvum.server "$@"
